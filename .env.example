# Copy this file to .env and fill in your own keys. Never commit .env.

# Required — Google Gemini LLM (title, summary, action items, decisions, questions, RAG chat)
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — Gemini chat model (default gemini-3.5-flash-lite, a free-tier Flash-Lite model)
GEMINI_MODEL=

# Required ONLY for Hinglish transcription (Sarvam AI)
SARVAM_API_KEY=

# Recommended for YouTube URLs — Supadata transcript API (fetches the video's captions, so no
# audio download is needed; YouTube often blocks audio downloads from cloud servers)
SUPADATA_API_KEY=

# Optional — Whisper model size: tiny / base / small / medium / large
WHISPER_MODEL=small

# Optional — Sarvam speech-to-text-translate model
SARVAM_STT_MODEL=saaras:v3
